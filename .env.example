# Set these in Render Environment settings; never commit real values.
BOT_TOKEN=
DATABASE_URL=
# Required: comma-separated Telegram numeric IDs allowed to manage account records.
ADMIN_IDS=
# Required: generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key stable and private; changing it makes previously encrypted tokens unreadable.
TOKEN_ENCRYPTION_KEY=
